// use prisma-8

model Teacher {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  // Null until the teacher creates a password (accounts that existed before
  // passwords do this at their next sign-in).
  passwordHash String?
  classes      Class[]
  createdAt DateTime @default(now()) @onCreate(now())
}

model Class {
  id             Int          @id @default(autoincrement())
  name           String
  syllabusText   String
  quizOpen       Boolean      @default(false)
  // Short code students enter to reach this class. Nullable so adding this
  // column to an existing table never requires backfilling old rows — a
  // class created before this feature just shows no code until recreated.
  // (Postgres allows multiple NULLs under a unique constraint.)
  joinCode       String?      @unique
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  teacherId      Int
  submissions    Submission[]
  enrollments    Enrollment[]
  assignments    Assignment[]
  createdAt      DateTime     @default(now()) @onCreate(now())
}

// A specific piece of work within a class — "Essay 1", "Reading journal
// week 3", etc. Governed by the class's own syllabusText (that's the single
// source of AI-use rules); an assignment just adds what the student is
// actually being asked to do, and whether it's currently open for
// submission.
model Assignment {
  id           Int          @id @default(autoincrement())
  class        Class        @relation(fields: [classId], references: [id])
  classId      Int
  title        String
  instructions String
  open         Boolean      @default(false)
  // Separate from `open`: students can submit while the quiz stays locked;
  // the comprehension quiz only appears once the teacher activates it.
  quizOpen     Boolean      @default(false)
  submissions  Submission[]
  createdAt    DateTime     @default(now()) @onCreate(now())
}

// A student's membership in a class. Students have no password-based
// account — their identity is just the name/email in their session cookie
// (see src/lib/student-auth.ts) — so this table is what lets one student
// belong to several classes instead of a single class living in the cookie.
model Enrollment {
  id           Int      @id @default(autoincrement())
  class        Class    @relation(fields: [classId], references: [id])
  classId      Int
  studentName  String
  studentEmail String
  createdAt    DateTime @default(now()) @onCreate(now())

  @@unique([classId, studentEmail])
}

model Submission {
  id              Int        @id @default(autoincrement())
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId    Int
  class           Class      @relation(fields: [classId], references: [id])
  classId         Int
  studentName     String
  studentEmail    String
  assignmentText  String
  transcript      String
  quiz            Json?
  quizAnswers     Json?
  reportCard      Json?
  studentResponse String?
  status          String     @default("submitted")
  createdAt       DateTime   @default(now()) @onCreate(now())
  updatedAt       temporal.UpdatedAt

  @@unique([assignmentId, studentEmail])
}

// A student account. Class membership still lives in Enrollment (keyed by
// email); this row only holds identity and credentials. Students who used the
// app before accounts existed get a row the first time they sign in again.
model Student {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  // Null until set, and reset to null when a teacher resets it.
  passwordHash String?
  createdAt    DateTime @default(now()) @onCreate(now())
}

// One row per Claude API call, for the admin spending page and the budget
// hard stop. costUsd is estimated from token counts (see src/lib/ai.ts).
model ApiCall {
  id           Int      @id @default(autoincrement())
  // "analysis" | "grading" | "suggestions" | "lab" | "eval"
  step         String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  durationMs   Int
  ok           Boolean
  classId      Int?
  createdAt    DateTime @default(now()) @onCreate(now())

  @@index([createdAt])
}

// Admin settings as key/value (monthly budget, alert threshold, hard stop).
model AdminSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

// A completed test-set run, for the model-quality history.
model EvalRun {
  id              Int      @id @default(autoincrement())
  version         String
  total           Int
  judged          Int
  correct         Int
  relianceJudged  Int
  relianceCorrect Int
  borderline      Int
  errors          Int
  costUsd         Float
  detail          Json?
  createdAt       DateTime @default(now()) @onCreate(now())
}

// Test cases saved from the admin test lab; they join the built-in test set.
model LabCase {
  id             Int      @id @default(autoincrement())
  name           String
  syllabus       String
  transcript     String
  submission     String
  // "knows_work" | "vague"
  student        String
  // "review" | "no_review" | "either"
  expect         String
  expectReliance String?
  createdAt      DateTime @default(now()) @onCreate(now())
}
