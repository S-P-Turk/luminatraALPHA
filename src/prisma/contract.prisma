// use prisma-8

model Teacher {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  classes   Class[]
  createdAt DateTime @default(now()) @onCreate(now())
}

model Class {
  id             Int          @id @default(autoincrement())
  name           String
  syllabusText   String
  quizOpen       Boolean      @default(false)
  // Short code students enter to reach this class. Nullable so adding this
  // column to an existing table never requires backfilling old rows — a
  // class created before this feature just shows no code until recreated.
  // (Postgres allows multiple NULLs under a unique constraint.)
  joinCode       String?      @unique
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  teacherId      Int
  submissions    Submission[]
  createdAt      DateTime     @default(now()) @onCreate(now())
}

model Submission {
  id              Int      @id @default(autoincrement())
  class           Class    @relation(fields: [classId], references: [id])
  classId         Int
  studentName     String
  studentEmail    String
  assignmentText  String
  transcript      String
  quiz            Json?
  quizAnswers     Json?
  reportCard      Json?
  studentResponse String?
  status          String   @default("submitted")
  createdAt       DateTime @default(now()) @onCreate(now())
  updatedAt       temporal.UpdatedAt
}
